rules_version = '2';
// قواعد حماية نظام التصدير — EgyGulf Export System
// قبل النشر: حط إيميل المدير (نفس اللي في config.js) مكان YOUR_ADMIN_EMAIL@example.com بحروف small.
// الصلاحيات بالتابات: المدير بيختار لكل مستخدم التابات اللي تظهرله من صفحة المستخدمين.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function adminEmail() { return signedIn() && request.auth.token.email != null
                              && request.auth.token.email.lower() in ['kareemgulf5@gmail.com']; }
    function userPath()   { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function me()         { return get(userPath()).data; }
    function active()     { return adminEmail() || (hasProfile() && me().get('active', false) == true && me().get('role', '') != 'pending'); }
    function isAdmin()    { return adminEmail() || (active() && me().get('role', '') == 'admin'); }
    function hasTab(ts)   { return isAdmin() || (active() && me().get('tabs', []).hasAny(ts)); }

    // المستخدمين: كل واحد يشوف نفسه، والمدير يعمل ويعدّل الكل
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && adminEmail());
      allow update, delete: if isAdmin();
    }

    match /settings/{id}  { allow read: if active(); allow write: if isAdmin() || (id == 'lines' && hasTab(['orders', 'production'])); }

    // الأوردرات: أي مستخدم فعّال يقرأ ويحدّث (الإنتاج والشهادات والحسابات بيكتبوا عليها)، والإنشاء من تاب الأوردرات
    match /orders/{id} {
      allow read: if active();
      allow create: if hasTab(['orders']);
      allow update: if active();
      allow delete: if isAdmin();
    }

    // الدفعات: الحسابات بس
    match /payments/{id} {
      allow read: if active();
      allow create, update: if hasTab(['accounts']);
      allow delete: if isAdmin();
    }

    match /customers/{id} { allow read: if active(); allow write: if hasTab(['customers', 'orders']); }
    match /products/{id}  { allow read: if active(); allow write: if hasTab(['products']); }
    match /tests/{id}     { allow read: if active(); allow write: if hasTab(['products', 'health', 'production']); }
    match /countries/{id} { allow read: if active(); allow write: if hasTab(['countries']); }
    match /certs/{id}     { allow read: if active(); allow write: if hasTab(['health', 'countries']); }
    match /cartons/{id}   { allow read: if active(); allow write: if hasTab(['calc', 'orders', 'production']); }
    match /team/{id}      { allow read: if active(); allow write: if hasTab(['team']); }
    match /samples/{id}   { allow read: if hasTab(['samples']); allow write: if hasTab(['samples']); }

    // الملفات المرفوعة (متخزنة أجزاء جوه Firestore) والعدادات
    match /files/{id}       { allow read, write: if active(); }
    match /file_chunks/{id} { allow read, write: if active(); }
    match /counters/{id}    { allow read, write: if active(); }

    // أي حاجة تانية مقفولة
    match /{document=**} { allow read, write: if false; }
  }
}
